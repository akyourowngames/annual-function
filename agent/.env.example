# --- data ---------------------------------------------------------------
# Same Supabase Postgres the app uses (pooler connection string).
DATABASE_URL=
NEXTJS_BASE_URL=https://annual-five.vercel.app
# Needed only for confirmed actions (announcements, ticket replies, check-in).
ADMIN_ACCESS_KEY=
# What organizers type on the Backstage page. Change it.
ASSISTANT_KEY=backstage

# --- brain: fastest first ----------------------------------------------
# Groq: free tier, no card, LPU — ~500ms phrasing, ~1.2s full tool round.
# Get a key at console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
# Groq's open models reason before answering; low effort keeps replies snappy.
GROQ_REASONING_EFFORT=low

# NVIDIA NIM — the second brain (non-reasoning model by default).
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Kilo (or any OpenAI-compatible gateway) as the last resort.
FALLBACK_BASE_URL=https://api.kilo.ai/api/gateway
FALLBACK_API_KEY=
FALLBACK_MODELS=kilo-auto/free,inclusionai/ling-3.0-flash-sante:free,stepfun/step-3.7-flash:free,openrouter/free

# --- retrieval: NIM embeddings (2048-dim, matches the app's halfvec) ----
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_API_KEY=
EMBED_MODEL=nvidia/nemotron-3-embed-1b

# --- behaviour ----------------------------------------------------------
# model  = let the model word fast-path answers (natural, ~0.5s)
# template = skip the model, instant and mechanical, works offline
PHRASE_MODE=model

# --- voice (Edge TTS neural voices; free, no key) -----------------------
# Pick another in the UI. Good options:
#   en-IN-NeerjaExpressiveNeural (default), en-IN-PrabhatNeural,
#   en-US-AvaMultilingualNeural, en-US-EmmaMultilingualNeural, en-GB-SoniaNeural
TTS_VOICE=en-IN-NeerjaExpressiveNeural
# Slightly brisk, suits a busy organizer.
TTS_RATE=+8%

# --- server -------------------------------------------------------------
# 127.0.0.1 = this laptop only. 0.0.0.0 = reachable from phones on the LAN
# (the mic then needs https — see README).
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
