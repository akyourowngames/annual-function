# Settings for the annual-function MCP server.
# Copy this file to .env.local and fill in the real values.
# .env.local holds a password. Keep it on this machine only.

# The event database. Supabase → Project settings → Database → connection string.
# Needed for every report. Reading only.
DATABASE_URL=

# Where the website lives. Used for changes, never for reports.
# Local development:
NEXTJS_BASE_URL=http://127.0.0.1:3000
# Or the deployed site:
# NEXTJS_BASE_URL=https://annual-five.vercel.app

# Ankita's own school account (Supabase user with role "staff").
# This is what makes the activity log name her, not "the admin".
ANKITA_EMAIL=
ANKITA_PASSWORD=
