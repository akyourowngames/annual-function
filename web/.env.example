DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative to a Supabase administrator account:
ADMIN_ACCESS_KEY=
# --- Messaging agent LLM (OpenAI-compatible) ---
# Defaults to the Kilo AI Gateway with a fast free model. Swap providers by
# setting these three — any OpenAI-compatible gateway works, no code change.
LLM_BASE_URL=https://api.kilo.ai/api/gateway
LLM_API_KEY=
LLM_MODEL=kilo-auto/free
# Optional: comma-separated extra models tried if the primary errors/times out.
LLM_MODEL_FALLBACKS=
# --- Embeddings (semantic RAG; optional — lexical search works without it) ---
# NVIDIA NIM is OpenAI-compatible and free with an nvapi- key:
#   LLM_EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# LLM_EMBED_DIM must match the vector(N) column (migration 0006 = 2048).
# LLM_EMBED_INPUT_TYPE=1 sends query/passage hints (NVIDIA QA embedders).
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=
LLM_EMBED_DIM=2048
LLM_EMBED_INPUT_TYPE=0
# Meta WhatsApp Business Cloud API (production: Vercel env, never commit values)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# --- Telegram test-only bot (owner fills web/.env.local; values never committed) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
